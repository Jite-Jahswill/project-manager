// Ventidoc data model.
//
// Conventions (see docs/architecture/03-data-model.md):
// - Every tenant-owned table carries organization_id and is protected by
//   PostgreSQL Row-Level Security (policies live in hand-written SQL migrations).
// - Child rows reference parents through composite (id, organization_id) foreign
//   keys so the database itself rejects cross-tenant relationships.
// - Money is stored as integer minor units (BigInt) plus an ISO-4217 currency code.
// - Ledger-style tables (audit_events, stock_movements) are append-only for the
//   application role.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication (global, not tenant-owned)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique // always stored lower-cased and trimmed
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  displayName       String     @map("display_name")
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Non-secret flag mirrored from user_mfa_factors (authoritative). Lets AuthGuard
  /// enforce MFA without reading the restricted tables on every request.
  mfaEnabledAt      DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential             UserCredential?
  mfaFactor              UserMfaFactor?
  mfaEnrollment          UserMfaEnrollment?
  recoveryCodes          UserMfaRecoveryCode[]
  mfaChallenges          MfaChallenge[]
  mfaRecoveryTargeted    MfaRecoveryRequest[]       @relation("MfaRecoveryTarget")
  mfaRecoveryRequested   MfaRecoveryRequest[]       @relation("MfaRecoveryRequester")
  mfaRecoveryDecided     MfaRecoveryRequest[]       @relation("MfaRecoveryDecider")
  sessions               Session[]
  actionTokens           UserActionToken[]
  memberships            OrganizationMembership[]
  platformAdmin          PlatformAdmin?
  supportConversations   SupportConversation[]      @relation("SupportCustomer")
  supportMessages        SupportMessage[]           @relation("SupportMessageAuthor")
  supportNotes           SupportInternalNote[]      @relation("SupportNoteAuthor")
  supportAssignmentsMade SupportAssignment[]        @relation("SupportAssignmentActor")
  supportEvents          SupportConversationEvent[] @relation("SupportEventActor")
  supportReadMarkers     SupportReadMarker[]        @relation("SupportReader")
  supportUploads         SupportAttachment[]        @relation("SupportUploader")

  @@map("users")
}

/// Password hashes, isolated from every other table. Only the ventidoc_auth role
/// can read or write this table; the main application role (ventidoc_app) has no
/// privileges on it. Application code must use CredentialStore, never Prisma
/// (lint-enforced): the Prisma client connects as ventidoc_app.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Confirmed TOTP factor. ventidoc_auth only (MfaStore); the secret is AES-256-GCM
/// encrypted with a key outside the database (MFA_ENCRYPTION_KEYS).
model UserMfaFactor {
  userId           String   @id @map("user_id") @db.Uuid
  secretCiphertext String   @map("secret_ciphertext")
  confirmedAt      DateTime @map("confirmed_at") @db.Timestamptz(3)
  /// Highest TOTP time step ever accepted; codes for this step or earlier are replays.
  lastUsedStep     BigInt   @default(0) @map("last_used_step")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa_factors")
}

/// Enrollment in progress (not yet proven). ventidoc_auth only.
model UserMfaEnrollment {
  userId           String   @id @map("user_id") @db.Uuid
  secretCiphertext String   @map("secret_ciphertext")
  /// SHA-256 of the one-time code emailed for a FIRST enrollment (proof of inbox control).
  emailCodeHash    String?  @map("email_code_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  attempts         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa_enrollments")
}

/// Single-use recovery codes; only SHA-256 hashes of 80-bit random codes. ventidoc_auth only.
model UserMfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_mfa_recovery_codes")
}

/// Pending second-factor step after a correct password. Opaque, hashed, short-lived,
/// single-use; deliberately not a session, access token or refresh token.
model MfaChallenge {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  tokenHash  String     @unique @map("token_hash")
  clientType ClientType @map("client_type")
  deviceName String?    @map("device_name")
  ipAddress  String?    @map("ip_address")
  userAgent  String?    @map("user_agent")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

enum MfaRecoveryStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// Two-person administrative MFA recovery (docs/security/mfa.md §8). Requester and
/// approver must be different platform administrators, neither may be the target;
/// enforced by CHECK constraints, an immutability trigger and RLS (platform scope only).
model MfaRecoveryRequest {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetUserId String            @map("target_user_id") @db.Uuid
  requestedBy  String            @map("requested_by") @db.Uuid
  reason       String
  status       MfaRecoveryStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  decidedBy    String?           @map("decided_by") @db.Uuid
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz(3)
  decisionNote String?           @map("decision_note")
  executedAt   DateTime?         @map("executed_at") @db.Timestamptz(3)

  target    User  @relation("MfaRecoveryTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requester User  @relation("MfaRecoveryRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   User? @relation("MfaRecoveryDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([targetUserId])
  @@map("mfa_recovery_requests")
}

enum ClientType {
  WEB
  MOBILE
}

/// One login on one device. Refresh tokens rotate within a session; reuse of a
/// rotated token revokes the whole session.
model Session {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  clientType        ClientType @map("client_type")
  deviceName        String?    @map("device_name")
  ipAddress         String?    @map("ip_address")
  userAgent         String?    @map("user_agent")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?    @map("revoke_reason")
  /// Last password re-entry on this session; privileged actions require it to be recent.
  reauthenticatedAt DateTime?  @map("reauthenticated_at") @db.Timestamptz(3)
  /// Set when this session was established (or upgraded) with a verified second factor.
  mfaVerifiedAt     DateTime?  @map("mfa_verified_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // SHA-256 of the opaque token
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum UserActionPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserActionToken {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  purpose    UserActionPurpose
  tokenHash  String            @unique @map("token_hash")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_action_tokens")
}

// ---------------------------------------------------------------------------
// Platform administration RBAC (separate from organization RBAC)
// ---------------------------------------------------------------------------

model PlatformPermission {
  key         String  @id
  description String
  /// Highly privileged operations require recent re-authentication / MFA.
  privileged  Boolean @default(false)

  roles PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions PlatformRolePermission[]
  admins      PlatformAdminRole[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("platform_role_permissions")
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

model PlatformAdmin {
  userId    String              @id @map("user_id") @db.Uuid
  status    PlatformAdminStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?             @map("created_by") @db.Uuid

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                  PlatformAdminRole[]
  supportAssigned        SupportConversation[] @relation("SupportAssignee")
  supportAssignmentsTo   SupportAssignment[]   @relation("SupportAssignmentAssignee")
  supportAssignmentsFrom SupportAssignment[]   @relation("SupportAssignmentPrevious")

  @@map("platform_admins")
}

model PlatformAdminRole {
  adminUserId String @map("admin_user_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid

  admin PlatformAdmin @relation(fields: [adminUserId], references: [userId], onDelete: Cascade)
  role  PlatformRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("platform_admin_roles")
}

// ---------------------------------------------------------------------------
// Organizations, memberships, branches
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id              String             @id @db.Uuid // generated by the API so tenant context can be set before insert
  name            String
  slug            String             @unique
  status          OrganizationStatus @default(ACTIVE)
  defaultCurrency String             @default("USD") @map("default_currency") @db.Char(3)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  /// Optimistic concurrency for profile updates.
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships          OrganizationMembership[]
  branches             Branch[]
  roles                Role[]
  invitations          OrganizationInvitation[]
  subscription         OrganizationSubscription?
  products             Product[]
  supportConversations SupportConversation[]
  productCategories    ProductCategory[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]

  @@map("organizations")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]
  overrides    MembershipPermissionOverride[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

enum BranchStatus {
  ACTIVE
  ARCHIVED
}

model Branch {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  status         BranchStatus @default(ACTIVE)
  /// Optimistic concurrency for edits and lifecycle changes.
  version        Int          @default(1)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleAssignments MembershipRole[]
  overrides       MembershipPermissionOverride[]
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  invitations     OrganizationInvitation[]

  stockCounts     StockCount[]
  transfersOut    StockTransfer[]  @relation("TransferFrom")
  transfersIn     StockTransfer[]  @relation("TransferTo")
  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]   @relation("ReceiptBranch")
  supplierReturns SupplierReturn[] @relation("ReturnBranch")

  customers       Customer[]
  cashierSessions CashierSession[]
  sales           Sale[]
  saleReturns     SaleReturn[]

  expenses      Expense[]
  cashMovements CashMovement[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("branches")
}

model OrganizationInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String
  roleId          String?   @map("role_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Resends rotate the token; bounded per invitation.
  resendCount     Int       @default(0) @map("resend_count")
  lastSentAt      DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role?        @relation(fields: [roleId, organizationId], references: [id, organizationId])
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Organization RBAC
// ---------------------------------------------------------------------------

enum PermissionSensitivity {
  STANDARD
  RESTRICTED
}

enum PermissionScope {
  ORGANIZATION
  BRANCH
}

/// Catalog of organization permissions. Rows are synced from the code registry
/// (src/authz/permission-registry.ts); the FK from role_permissions guarantees a
/// role can only hold permissions that actually exist.
model Permission {
  key         String                @id
  module      String
  resource    String
  action      String
  scope       PermissionScope
  sensitivity PermissionSensitivity
  description String

  rolePermissions RolePermission[]
  exclusions      RolePermissionExclusion[]
  overrides       MembershipPermissionOverride[]

  @@map("permissions")
}

model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String
  description     String?
  /// System roles (Owner) cannot be edited or deleted.
  isSystem        Boolean  @default(false) @map("is_system")
  /// The starter template this role was created from, if any.
  templateKey     String?  @map("template_key")
  /// Template version whose permissions this role has received (role-template-history.ts).
  /// NULL for custom and system roles, and for template roles created before versions were recorded (= version 1).
  templateVersion Int?     @map("template_version")
  /// Optimistic concurrency: edits must name the version they were based on (incremented by every
  /// change to the role or its permissions, including template sync grants).
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  exclusions   RolePermissionExclusion[]
  assignments  MembershipRole[]
  invitations  OrganizationInvitation[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("roles")
}

/// Singleton (id = 1): the role template version every existing organization has been synced to.
/// Written by the seed (syncRoleTemplates); the API refuses to start while it is behind the code.
model RoleTemplateState {
  id       Int      @id @default(1) @db.SmallInt
  version  Int
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@map("role_template_state")
}

/// Permissions an organization deliberately removed from one of its template roles. The role
/// template sync never re-grants these (docs/architecture/10-organizations.md §10.6.1). Written
/// and cleared by role edits; template roles only.
model RolePermissionExclusion {
  organizationId   String   @map("organization_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  permissionKey    String   @map("permission_key")
  excludedByUserId String?  @map("excluded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@map("role_permission_exclusions")
}

model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionKey  String @map("permission_key")

  role       Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@map("role_permissions")
}

/// Assigns a role to a membership, organization-wide (branch_id NULL) or for one branch.
/// This is also the branch assignment record: a member works at a branch by holding a role there.
model MembershipRole {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  membershipId     String   @map("membership_id") @db.Uuid
  roleId           String   @map("role_id") @db.Uuid
  branchId         String?  @map("branch_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch     Branch?                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@map("membership_roles")
}

enum OverrideEffect {
  GRANT
  DENY
}

/// User-specific exception to role-derived permissions. Precedence: DENY > GRANT > roles.
model MembershipPermissionOverride {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  membershipId    String         @map("membership_id") @db.Uuid
  permissionKey   String         @map("permission_key")
  effect          OverrideEffect
  branchId        String?        @map("branch_id") @db.Uuid
  reason          String
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  permission Permission             @relation(fields: [permissionKey], references: [key])
  branch     Branch?                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, membershipId])
  @@map("membership_permission_overrides")
}

// ---------------------------------------------------------------------------
// Subscriptions & entitlements
// ---------------------------------------------------------------------------

model Plan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  prices        PlanPrice[]
  entitlements  PlanEntitlement[]
  subscriptions OrganizationSubscription[]

  @@map("plans")
}

enum BillingInterval {
  MONTH
  YEAR
}

model PlanPrice {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String          @map("plan_id") @db.Uuid
  currency    String          @db.Char(3)
  amountMinor BigInt          @map("amount_minor")
  interval    BillingInterval
  isActive    Boolean         @default(true) @map("is_active")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, interval])
  @@map("plan_prices")
}

/// A feature flag (enabled) or a numeric limit (limitValue; NULL = unlimited).
model PlanEntitlement {
  planId     String  @map("plan_id") @db.Uuid
  key        String
  enabled    Boolean @default(true)
  limitValue Int?    @map("limit_value")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, key])
  @@map("plan_entitlements")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  RESTRICTED
  CANCELED
  EXPIRED
}

model OrganizationSubscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  graceEndsAt        DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("organization_subscriptions")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

enum ActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

model AuditEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// NULL for identity/platform events that belong to no organization.
  organizationId String?   @map("organization_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id")
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Inventory (first vertical slice)
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  /// Kept in the catalogue but not purchasable; stock can still be counted or adjusted out.
  INACTIVE
  ARCHIVED
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

/// Product groupings (one level of parent allowed). Never deleted; archived instead.
model ProductCategory {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  /// lower(trim(name)): uniqueness without case/space variants.
  nameNormalized String        @map("name_normalized")
  parentId       String?       @map("parent_id") @db.Uuid
  status         CatalogStatus @default(ACTIVE)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       ProductCategory?  @relation("CategoryParent", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children     ProductCategory[] @relation("CategoryParent")
  products     Product[]

  @@unique([organizationId, nameNormalized])
  @@unique([id, organizationId])
  @@map("product_categories")
}

model Product {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  sku               String
  name              String
  unit              String        @default("each")
  /// Decimal places allowed for quantities in this unit (0 = whole units). Fixed once stock exists.
  quantityScale     Int           @default(3) @map("quantity_scale")
  status            ProductStatus @default(ACTIVE)
  description       String?
  categoryId        String?       @map("category_id") @db.Uuid
  /// Unique per organization when present (EAN/UPC or internal code).
  barcode           String?
  /// Money in integer minor units of `currency`. Cost is restricted (inventory.cost.read).
  costPriceMinor    BigInt?       @map("cost_price_minor")
  sellingPriceMinor BigInt?       @map("selling_price_minor")
  currency          String        @default("USD") @db.Char(3)
  /// Low-stock threshold per branch (null = none).
  reorderLevel      Decimal?      @map("reorder_level") @db.Decimal(18, 3)
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           ProductCategory?    @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplierProducts   SupplierProduct[]
  purchaseOrderLines PurchaseOrderLine[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]

  countLines StockCountLine[]

  saleLines SaleLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@unique([id, organizationId])
  @@map("products")
}

/// Current on-hand quantity per (branch, product). Only changed together with a
/// stock_movements insert inside the same transaction.
model StockBalance {
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([branchId, productId])
  @@index([organizationId])
  @@map("stock_balances")
}

enum StockMovementType {
  ADJUSTMENT
  OPENING
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT
  RETURN_TO_SUPPLIER
  RECEIPT_CORRECTION
  REVERSAL
  SALE
  SALE_RETURN
  SALE_VOID
}

model StockMovement {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  type               StockMovementType
  quantityDelta      Decimal           @map("quantity_delta") @db.Decimal(18, 3)
  balanceAfter       Decimal           @map("balance_after") @db.Decimal(18, 3)
  reason             String
  actorUserId        String            @map("actor_user_id") @db.Uuid
  idempotencyKey     String            @map("idempotency_key")
  /// What produced the movement (transfer, count, goods receipt, supplier return) and its id.
  sourceType         String?           @map("source_type")
  sourceId           String?           @map("source_id") @db.Uuid
  /// For REVERSAL: the movement it cancels (each movement can be reversed once).
  reversesMovementId String?           @unique @map("reverses_movement_id") @db.Uuid
  /// For COUNT: the physical count; the database computes quantity_delta from it.
  countedQuantity    Decimal?          @map("counted_quantity") @db.Decimal(18, 3)
  unitCostMinor      BigInt?           @map("unit_cost_minor")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  branch     Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product    Product        @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reverses   StockMovement? @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy StockMovement? @relation("MovementReversal")

  countLines   StockCountLine[]     @relation("CountLineMovement")
  receiptLines GoodsReceiptLine[]   @relation("ReceiptLineMovement")
  returnLines  SupplierReturnLine[] @relation("ReturnLineMovement")

  saleLines SaleLine[] @relation("SaleLineMovement")

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, productId, createdAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Email platform (Stage 2C, docs/architecture/08-email-platform.md)
// ---------------------------------------------------------------------------

enum EmailProviderKind {
  RESEND
  SMTP
  LOG
  CAPTURE
}

enum EmailProviderStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum EmailTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  EXPIRED
  DISCARDED
  CANCELLED
}

enum EmailAttemptOutcome {
  SENT
  RETRYABLE
  PERMANENT
  AMBIGUOUS
}

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
  MANUAL
}

/// Single row (id = 1). Runtime email configuration managed through platform-admin APIs.
model EmailSettings {
  id                    Int      @id @default(1)
  activeProviderId      String?  @map("active_provider_id") @db.Uuid
  /// Real delivery switch. Off by default; can only be turned on for a verified provider + sender.
  sendingEnabled        Boolean  @default(false) @map("sending_enabled")
  defaultSenderId       String?  @map("default_sender_id") @db.Uuid
  retryMaxAttempts      Int      @default(8) @map("retry_max_attempts")
  retryBaseDelaySeconds Int      @default(30) @map("retry_base_delay_seconds")
  retryMaxDelaySeconds  Int      @default(3600) @map("retry_max_delay_seconds")
  maxSendsPerMinute     Int      @default(120) @map("max_sends_per_minute")
  /// Addresses that may receive admin test emails, besides the requesting admin's own.
  testRecipients        String[] @default([]) @map("test_recipients")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy             String?  @map("updated_by") @db.Uuid

  activeProvider EmailProvider?       @relation(fields: [activeProviderId], references: [id], onDelete: Restrict)
  defaultSender  EmailSenderIdentity? @relation(fields: [defaultSenderId], references: [id], onDelete: Restrict)

  @@map("email_settings")
}

model EmailProvider {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             EmailProviderKind
  name             String              @unique
  /// Non-secret, provider-validated settings (host, port, timeouts, API base URL...).
  settings         Json                @default("{}")
  secretConfigured Boolean             @default(false) @map("secret_configured")
  /// Safe indicator only (e.g. "re_…a1b2"); never the secret.
  secretHint       String?             @map("secret_hint")
  status           EmailProviderStatus @default(UNVERIFIED)
  lastCheckedAt    DateTime?           @map("last_checked_at") @db.Timestamptz(3)
  lastCheckSummary String?             @map("last_check_summary")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?             @map("updated_by") @db.Uuid

  secret         EmailProviderSecret?
  activeSettings EmailSettings[]

  @@map("email_providers")
}

/// Encrypted provider credential (Resend API key, SMTP password). ventidoc_auth only.
model EmailProviderSecret {
  providerId String   @id @map("provider_id") @db.Uuid
  ciphertext String
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  provider EmailProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("email_provider_secrets")
}

model EmailSenderIdentity {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique
  displayName        String    @map("display_name")
  replyTo            String?   @map("reply_to")
  domain             String
  /// Set only by a successful provider domain check, or an audited administrator attestation (SMTP).
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  verificationSource String?   @map("verification_source")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid

  defaultFor EmailSettings[]

  @@map("email_sender_identities")
}

model EmailTemplate {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  version     Int
  subject     String
  textBody    String              @map("text_body")
  htmlBody    String              @map("html_body")
  status      EmailTemplateStatus @default(DRAFT)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?             @map("created_by") @db.Uuid
  activatedAt DateTime?           @map("activated_at") @db.Timestamptz(3)
  activatedBy String?             @map("activated_by") @db.Uuid

  @@unique([key, version])
  @@map("email_templates")
}

/// Transactional outbox. Written in the caller's transaction; delivered by EmailWorker.
model EmailOutbox {
  id                  String         @id @db.Uuid
  eventType           String         @map("event_type")
  templateKey         String         @map("template_key")
  templateVersion     Int?           @map("template_version")
  organizationId      String?        @map("organization_id") @db.Uuid
  recipientUserId     String?        @map("recipient_user_id") @db.Uuid
  recipientEmail      String?        @map("recipient_email")
  /// Non-sensitive variables only; wiped at a terminal state.
  payload             Json           @default("{}")
  /// AES-256-GCM (EMAIL_SECRET_KEYS) for unavoidable one-time values; wiped at a terminal state.
  sensitiveCiphertext String?        @map("sensitive_ciphertext")
  status              EmailJobStatus @default(PENDING)
  attempts            Int            @default(0)
  nextAttemptAt       DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz(3)
  lockedBy            String?        @map("locked_by")
  expiresAt           DateTime       @map("expires_at") @db.Timestamptz(3)
  idempotencyKey      String         @unique @map("idempotency_key")
  testSend            Boolean        @default(false) @map("test_send")
  provider            String?
  providerMessageId   String?        @map("provider_message_id")
  lastErrorCode       String?        @map("last_error_code")
  lastError           String?        @map("last_error")
  contentWipedAt      DateTime?      @map("content_wiped_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)
  sentAt              DateTime?      @map("sent_at") @db.Timestamptz(3)

  attemptLog EmailDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([organizationId])
  @@map("email_outbox")
}

model EmailDeliveryAttempt {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxId          String              @map("outbox_id") @db.Uuid
  organizationId    String?             @map("organization_id") @db.Uuid
  attempt           Int
  provider          String
  startedAt         DateTime            @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime            @map("finished_at") @db.Timestamptz(3)
  outcome           EmailAttemptOutcome
  errorCode         String?             @map("error_code")
  errorSummary      String?             @map("error_summary")
  providerMessageId String?             @map("provider_message_id")
  durationMs        Int                 @map("duration_ms")

  outbox EmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId])
  @@index([finishedAt])
  @@map("email_delivery_attempts")
}

model EmailSuppression {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String                 @unique
  reason    EmailSuppressionReason
  note      String?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?                @map("created_by") @db.Uuid

  @@map("email_suppressions")
}

// ---------------------------------------------------------------------------
// Customer support (docs/architecture/09-support.md). Conversations belong to the
// customer (a user), not to an organization: organization owners and other tenant
// roles have no access to them. Staff access comes only from platform support
// permissions, checked by the API and again by RLS (app_has_platform_permission).
// ---------------------------------------------------------------------------

enum SupportConversationStatus {
  NEW
  OPEN
  PENDING_CUSTOMER
  PENDING_SUPPORT
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCategory {
  ACCOUNT
  BILLING
  TECHNICAL
  FEATURE_REQUEST
  OTHER
}

enum SupportAuthorKind {
  CUSTOMER
  STAFF
}

enum SupportEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  REOPENED
  NOTE_ADDED
}

model SupportConversation {
  id                  String                    @id @db.Uuid // generated by the API
  /// Human-facing identifier (SUP-XXXXXXXX). Safe to show in emails; carries no content.
  reference           String                    @unique
  customerUserId      String                    @map("customer_user_id") @db.Uuid
  /// Optional context: an organization the customer was an active member of when creating it.
  /// Gives the organization no access to the conversation.
  organizationId      String?                   @map("organization_id") @db.Uuid
  subject             String
  category            SupportCategory           @default(OTHER)
  priority            SupportPriority           @default(NORMAL)
  status              SupportConversationStatus @default(NEW)
  assigneeUserId      String?                   @map("assignee_user_id") @db.Uuid
  /// Bumped by the database whenever status, priority, category or assignee changes (optimistic concurrency).
  version             Int                       @default(1)
  /// Last allocated message sequence number (messages are numbered 1..n per conversation).
  messageSeq          Int                       @default(0) @map("message_seq")
  /// Preview of the last customer-visible message (never an internal note).
  lastMessagePreview  String?                   @map("last_message_preview")
  lastMessageAt       DateTime?                 @map("last_message_at") @db.Timestamptz(3)
  lastActivityAt      DateTime                  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// Read receipts across parties: highest seq read by the customer / by any support staff member.
  customerReadSeq     Int                       @default(0) @map("customer_read_seq")
  supportReadSeq      Int                       @default(0) @map("support_read_seq")
  /// Highest seq the customer / the assignee was emailed about (coalesces notifications).
  customerNotifiedSeq Int                       @default(0) @map("customer_notified_seq")
  assigneeNotifiedSeq Int                       @default(0) @map("assignee_notified_seq")
  resolvedAt          DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  closedAt            DateTime?                 @map("closed_at") @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer     User                       @relation("SupportCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignee     PlatformAdmin?             @relation("SupportAssignee", fields: [assigneeUserId], references: [userId], onDelete: Restrict)
  messages     SupportMessage[]
  notes        SupportInternalNote[]
  assignments  SupportAssignment[]
  events       SupportConversationEvent[]
  readMarkers  SupportReadMarker[]
  attachments  SupportAttachment[]

  @@index([customerUserId, lastActivityAt])
  @@index([status, lastActivityAt])
  @@index([assigneeUserId, status])
  @@index([lastActivityAt, id])
  @@map("support_conversations")
}

model SupportMessage {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String            @map("conversation_id") @db.Uuid
  seq             Int
  authorUserId    String            @map("author_user_id") @db.Uuid
  authorKind      SupportAuthorKind @map("author_kind")
  /// Plain text. Never rendered as HTML by the API.
  body            String
  /// Client-supplied idempotency key (retries of the same send return the same message).
  clientMessageId String?           @map("client_message_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author       User                @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments  SupportAttachment[]

  @@unique([conversationId, seq])
  @@unique([id, conversationId])
  @@unique([conversationId, authorUserId, clientMessageId])
  @@map("support_messages")
}

/// Staff-only. Separate table (not a message flag) so customer queries and policies never touch it.
model SupportInternalNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  clientNoteId   String?  @map("client_note_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author       User                @relation("SupportNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([conversationId, authorUserId, clientNoteId])
  @@index([conversationId, createdAt])
  @@map("support_internal_notes")
}

/// Append-only assignment history (one row per change).
model SupportAssignment {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId         String   @map("conversation_id") @db.Uuid
  previousAssigneeUserId String?  @map("previous_assignee_user_id") @db.Uuid
  assigneeUserId         String?  @map("assignee_user_id") @db.Uuid
  assignedByUserId       String   @map("assigned_by_user_id") @db.Uuid
  reason                 String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation     SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  previousAssignee PlatformAdmin?      @relation("SupportAssignmentPrevious", fields: [previousAssigneeUserId], references: [userId], onDelete: Restrict)
  assignee         PlatformAdmin?      @relation("SupportAssignmentAssignee", fields: [assigneeUserId], references: [userId], onDelete: Restrict)
  assignedBy       User                @relation("SupportAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("support_assignments")
}

/// Append-only lifecycle history (staff-visible). Never contains message or note text.
model SupportConversationEvent {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  type           SupportEventType
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  actorKind      SupportAuthorKind @map("actor_kind")
  data           Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actor        User?               @relation("SupportEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("support_conversation_events")
}

/// Per staff member last-read position (customers use support_conversations.customer_read_seq).
model SupportReadMarker {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadSeq    Int      @default(0) @map("last_read_seq")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User                @relation("SupportReader", fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("support_read_markers")
}

/// Metadata only. The bytes live in object storage under a server-generated key.
model SupportAttachment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  /// Set once, when the attachment is sent with a message by its uploader.
  messageId      String?           @map("message_id") @db.Uuid
  uploaderUserId String            @map("uploader_user_id") @db.Uuid
  uploaderKind   SupportAuthorKind @map("uploader_kind")
  storageKey     String            @unique @map("storage_key")
  fileName       String            @map("file_name")
  contentType    String            @map("content_type")
  sizeBytes      Int               @map("size_bytes")
  sha256         String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message      SupportMessage?     @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Restrict)
  uploader     User                @relation("SupportUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([messageId])
  @@map("support_attachments")
}

// ---------------------------------------------------------------------------
// Stock operations, suppliers and purchasing (docs/architecture/11-inventory-purchasing.md).
// Every table is tenant-owned (organization_id, FORCEd RLS, composite FKs).
// ---------------------------------------------------------------------------

/// A physical count at one branch; each differing line posts a COUNT movement.
model StockCount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  note           String
  actorUserId    String   @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lines StockCountLine[]

  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@map("stock_counts")
}

model StockCountLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  countId          String  @map("count_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(18, 3)
  countedQuantity  Decimal @map("counted_quantity") @db.Decimal(18, 3)
  movementId       String? @map("movement_id") @db.Uuid

  count StockCount @relation(fields: [countId, organizationId], references: [id, organizationId], onDelete: Restrict)

  product  Product        @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement StockMovement? @relation("CountLineMovement", fields: [movementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([countId, productId])
  @@map("stock_count_lines")
}

/// An immediate transfer between two active branches (out and in post together).
model StockTransfer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromBranchId   String   @map("from_branch_id") @db.Uuid
  toBranchId     String   @map("to_branch_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  reason         String
  actorUserId    String   @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  fromBranch Branch @relation("TransferFrom", fields: [fromBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  toBranch   Branch @relation("TransferTo", fields: [toBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, fromBranchId, createdAt])
  @@index([organizationId, toBranchId, createdAt])
  @@map("stock_transfers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  /// Organization-chosen reference (e.g. SUP-001), unique per organization.
  code             String
  name             String
  nameNormalized   String         @map("name_normalized")
  status           SupplierStatus @default(ACTIVE)
  /// Business contact only: no personal data beyond what ordering needs.
  contactName      String?        @map("contact_name")
  email            String?
  phone            String?
  address          String?
  taxId            String?        @map("tax_id")
  paymentTermsDays Int?           @map("payment_terms_days")
  currency         String         @db.Char(3)
  notes            String?
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@unique([organizationId, nameNormalized])
  @@unique([id, organizationId])
  @@map("suppliers")
}

model SupplierProduct {
  organizationId       String   @map("organization_id") @db.Uuid
  supplierId           String   @map("supplier_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  supplierSku          String?  @map("supplier_sku")
  defaultUnitCostMinor BigInt?  @map("default_unit_cost_minor")
  leadTimeDays         Int?     @map("lead_time_days")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product  Product  @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([supplierId, productId])
  @@index([organizationId, productId])
  @@map("supplier_products")
}

/// Per-organization counters for human-readable document numbers (PO-000001).
model OrganizationSequence {
  organizationId String @map("organization_id") @db.Uuid
  name           String
  lastValue      Int    @default(0) @map("last_value")

  @@id([organizationId, name])
  @@map("organization_sequences")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  number            String
  supplierId        String              @map("supplier_id") @db.Uuid
  /// Destination branch (receiving location).
  branchId          String              @map("branch_id") @db.Uuid
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String              @db.Char(3)
  /// Sum of line totals, maintained by the database from the lines.
  subtotalMinor     BigInt              @default(0) @map("subtotal_minor")
  notes             String?
  expectedDate      DateTime?           @map("expected_date") @db.Date
  version           Int                 @default(1)
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  submittedByUserId String?             @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)
  decidedByUserId   String?             @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(3)
  /// Approved by the submitter, which needs purchasing.order.self_approve (audited).
  selfApproved      Boolean             @default(false) @map("self_approved")
  rejectionReason   String?             @map("rejection_reason")
  issuedAt          DateTime?           @map("issued_at") @db.Timestamptz(3)
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeReason       String?             @map("close_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier             @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  events   PurchaseOrderEvent[]
  receipts GoodsReceipt[]
  returns  SupplierReturn[]

  branch Branch @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  lineNo           Int     @map("line_no")
  productId        String  @map("product_id") @db.Uuid
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(18, 3)
  unitCostMinor    BigInt  @map("unit_cost_minor")
  /// round(quantity_ordered × unit_cost_minor), checked by the database.
  lineTotalMinor   BigInt  @map("line_total_minor")
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 3)
  quantityReturned Decimal @default(0) @map("quantity_returned") @db.Decimal(18, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product       Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  receiptLines GoodsReceiptLine[]
  returnLines  SupplierReturnLine[]

  @@unique([purchaseOrderId, lineNo])
  @@unique([purchaseOrderId, productId])
  @@unique([id, organizationId])
  @@map("purchase_order_lines")
}

/// Append-only status history.
model PurchaseOrderEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  type            String
  fromStatus      String?  @map("from_status")
  toStatus        String?  @map("to_status")
  actorUserId     String   @map("actor_user_id") @db.Uuid
  reason          String?
  data            Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([purchaseOrderId, createdAt])
  @@map("purchase_order_events")
}

/// One posting of received goods (idempotent per Idempotency-Key). Append-only.
model GoodsReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  idempotencyKey  String   @map("idempotency_key")
  note            String?
  actorUserId     String   @map("actor_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines         GoodsReceiptLine[]

  branch Branch @relation("ReceiptBranch", fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  receiptId      String  @map("receipt_id") @db.Uuid
  lineId         String  @map("line_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 3)
  movementId     String  @map("movement_id") @db.Uuid

  receipt GoodsReceipt @relation(fields: [receiptId, organizationId], references: [id, organizationId], onDelete: Restrict)

  line     PurchaseOrderLine @relation(fields: [lineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement StockMovement     @relation("ReceiptLineMovement", fields: [movementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([receiptId, lineId])
  @@map("goods_receipt_lines")
}

enum SupplierReturnType {
  /// Goods sent back to the supplier (received quantity stays; returned quantity grows).
  RETURN
  /// A receipt recorded too much (received quantity is reduced; the order can be received again).
  RECEIPT_CORRECTION
}

/// Append-only.
model SupplierReturn {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  branchId        String             @map("branch_id") @db.Uuid
  type            SupplierReturnType
  idempotencyKey  String             @map("idempotency_key")
  reason          String
  actorUserId     String             @map("actor_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines         SupplierReturnLine[]

  branch Branch @relation("ReturnBranch", fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  returnId       String  @map("return_id") @db.Uuid
  lineId         String  @map("line_id") @db.Uuid
  quantity       Decimal @db.Decimal(18, 3)
  movementId     String  @map("movement_id") @db.Uuid

  supplierReturn SupplierReturn @relation(fields: [returnId, organizationId], references: [id, organizationId], onDelete: Restrict)

  line     PurchaseOrderLine @relation(fields: [lineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement StockMovement     @relation("ReturnLineMovement", fields: [movementId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([returnId, lineId])
  @@map("supplier_return_lines")
}

// ---------------------------------------------------------------------------
// Sales, POS sessions, payments, refunds and returns (docs/architecture/12-sales.md).
// Tenant-owned (FORCEd RLS, composite FKs). Stock moves only through stock_movements.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  /// Branch that registered the customer: branch-limited staff see their branches' customers.
  homeBranchId    String?        @map("home_branch_id") @db.Uuid
  name            String
  /// Optional contact; normalized (lower-case email, digits-only phone with optional +) and unique per organization.
  email           String?
  phone           String?
  notes           String?
  status          CustomerStatus @default(ACTIVE)
  version         Int            @default(1)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  homeBranch Branch? @relation(fields: [homeBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sales      Sale[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("customers")
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

/// A cashier's shift at one branch. At most one OPEN session per cashier and branch.
model CashierSession {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  branchId          String               @map("branch_id") @db.Uuid
  cashierUserId     String               @map("cashier_user_id") @db.Uuid
  status            CashierSessionStatus @default(OPEN)
  currency          String               @db.Char(3)
  openingFloatMinor BigInt               @map("opening_float_minor")
  openedAt          DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  /// Set at close: float + cash payments − cash refunds recorded in the session.
  expectedCashMinor BigInt?              @map("expected_cash_minor")
  declaredCashMinor BigInt?              @map("declared_cash_minor")
  varianceMinor     BigInt?              @map("variance_minor")
  closedAt          DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedByUserId    String?              @map("closed_by_user_id") @db.Uuid
  closeNote         String?              @map("close_note")
  version           Int                  @default(1)

  branch        Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sales         Sale[]
  payments      Payment[]
  refunds       Refund[]
  cashMovements CashMovement[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, status])
  @@map("cashier_sessions")
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

/// A posted sale. Created complete (stock posted in the same transaction); never edited, only voided.
model Sale {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  branchId        String     @map("branch_id") @db.Uuid
  sessionId       String     @map("session_id") @db.Uuid
  customerId      String?    @map("customer_id") @db.Uuid
  /// Receipt number, unique per organization (R-000001).
  number          String
  idempotencyKey  String     @map("idempotency_key")
  status          SaleStatus @default(COMPLETED)
  currency        String     @db.Char(3)
  /// Sum of line totals; the database verifies it at commit.
  totalMinor      BigInt     @map("total_minor")
  /// For exchanges: the return this replacement sale follows (traceability; separate operations).
  relatedReturnId String?    @map("related_return_id") @db.Uuid
  cashierUserId   String     @map("cashier_user_id") @db.Uuid
  version         Int        @default(1)
  voidedAt        DateTime?  @map("voided_at") @db.Timestamptz(3)
  voidedByUserId  String?    @map("voided_by_user_id") @db.Uuid
  voidReason      String?    @map("void_reason")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  branch   Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session  CashierSession @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer Customer?      @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines    SaleLine[]
  payments Payment[]
  refunds  Refund[]
  returns  SaleReturn[]   @relation("SaleReturns")

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, customerId])
  @@map("sales")
}

model SaleLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  saleId           String  @map("sale_id") @db.Uuid
  lineNo           Int     @map("line_no")
  productId        String  @map("product_id") @db.Uuid
  quantity         Decimal @db.Decimal(18, 3)
  /// The product's selling price at the time of sale (server-side).
  unitPriceMinor   BigInt  @map("unit_price_minor")
  lineTotalMinor   BigInt  @map("line_total_minor")
  quantityReturned Decimal @default(0) @map("quantity_returned") @db.Decimal(18, 3)
  /// The SALE stock movement that took this line out of stock.
  movementId       String  @map("movement_id") @db.Uuid

  sale        Sale             @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  product     Product          @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  movement    StockMovement    @relation("SaleLineMovement", fields: [movementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  returnLines SaleReturnLine[]

  @@unique([saleId, lineNo])
  @@unique([saleId, productId])
  @@unique([id, organizationId])
  @@map("sale_lines")
}

enum PaymentMethod {
  CASH
  /// Card taken on an external terminal: only the terminal's reference is stored, never card data.
  CARD_EXTERNAL
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// A payment recorded by staff. Not verified with any bank or processor: CONFIRMED means a
/// staff member with sales.payment.confirm attested it (see verification).
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  saleId            String        @map("sale_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  /// Required for cash (the drawer it went into).
  sessionId         String?       @map("session_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amountMinor       BigInt        @map("amount_minor")
  /// Sum of refunds against this payment (maintained under the payment row lock; CHECK ≤ amount).
  refundedMinor     BigInt        @default(0) @map("refunded_minor")
  /// External reference (terminal slip, transfer reference). Never card numbers or credentials.
  reference         String?
  /// Always MANUAL here: no processor or bank integration exists.
  verification      String        @default("MANUAL")
  idempotencyKey    String        @map("idempotency_key")
  recordedByUserId  String        @map("recorded_by_user_id") @db.Uuid
  confirmedByUserId String?       @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  failureReason     String?       @map("failure_reason")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  sale    Sale            @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session CashierSession? @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  refunds Refund[]

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([saleId])
  @@index([sessionId])
  @@map("payments")
}

/// Money back against one confirmed payment. Append-only. Never restocks by itself.
model Refund {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  /// The return this refund settles, if any.
  returnId       String?       @map("return_id") @db.Uuid
  sessionId      String?       @map("session_id") @db.Uuid
  method         PaymentMethod
  amountMinor    BigInt        @map("amount_minor")
  reason         String
  idempotencyKey String        @map("idempotency_key")
  actorUserId    String        @map("actor_user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  sale    Sale            @relation(fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  payment Payment         @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  return  SaleReturn?     @relation(fields: [returnId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session CashierSession? @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([paymentId])
  @@map("refunds")
}

enum SaleReturnStatus {
  /// Goods taken back; stock NOT restored.
  ACCEPTED
  /// Resaleable lines posted back to stock (SALE_RETURN movements) by an authorized user.
  RESTOCKED
}

enum ReturnDisposition {
  RESALEABLE
  DAMAGED
  UNSELLABLE
}

model SaleReturn {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  saleId            String           @map("sale_id") @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  idempotencyKey    String           @map("idempotency_key")
  status            SaleReturnStatus @default(ACCEPTED)
  reason            String
  acceptedByUserId  String           @map("accepted_by_user_id") @db.Uuid
  restockedByUserId String?          @map("restocked_by_user_id") @db.Uuid
  restockedAt       DateTime?        @map("restocked_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  sale    Sale             @relation("SaleReturns", fields: [saleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch  Branch           @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines   SaleReturnLine[]
  refunds Refund[]

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnLine {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  returnId       String            @map("return_id") @db.Uuid
  saleLineId     String            @map("sale_line_id") @db.Uuid
  quantity       Decimal           @db.Decimal(18, 3)
  disposition    ReturnDisposition

  saleReturn SaleReturn @relation(fields: [returnId, organizationId], references: [id, organizationId], onDelete: Restrict)
  saleLine   SaleLine   @relation(fields: [saleLineId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([returnId, saleLineId])
  @@map("sale_return_lines")
}

// ===========================================================================
// Finance: expenses and operational cash movements (docs/architecture/13-finance.md)
// ===========================================================================

enum ExpenseCategoryStatus {
  ACTIVE
  ARCHIVED
}

/// DRAFT -> SUBMITTED -> APPROVED | REJECTED; DRAFT/SUBMITTED -> CANCELLED; APPROVED -> VOIDED.
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  VOIDED
}

enum CashMovementType {
  PAID_IN
  PAID_OUT
  CASH_DROP
  BANK_DEPOSIT
  BANK_WITHDRAWAL
  REVERSAL
}

enum CashDirection {
  IN
  OUT
}

model ExpenseCategory {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  name            String
  /// lower(trim(collapsed spaces)): unique per organization.
  normalizedName  String                @map("normalized_name")
  description     String?
  status          ExpenseCategoryStatus @default(ACTIVE)
  version         Int                   @default(1)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, normalizedName])
  @@unique([id, organizationId])
  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  /// NULL: an organization-level expense (only org-wide permission holders see it).
  branchId          String?       @map("branch_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  /// E-000001, per organization.
  number            String
  status            ExpenseStatus @default(DRAFT)
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @db.Char(3)
  description       String
  reference         String?
  /// Business date the expense was incurred (a calendar date; no time zone).
  occurredOn        DateTime      @map("occurred_on") @db.Date
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  submittedByUserId String?       @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz(3)
  decidedByUserId   String?       @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?     @map("decided_at") @db.Timestamptz(3)
  rejectionReason   String?       @map("rejection_reason")
  cancelledByUserId String?       @map("cancelled_by_user_id") @db.Uuid
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?       @map("cancel_reason")
  voidedByUserId    String?       @map("voided_by_user_id") @db.Uuid
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason        String?       @map("void_reason")
  /// A replacement for a VOIDED expense (explicit correction).
  correctsExpenseId String?       @map("corrects_expense_id") @db.Uuid
  idempotencyKey    String        @map("idempotency_key")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  category     ExpenseCategory     @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  corrects     Expense?            @relation("ExpenseCorrection", fields: [correctsExpenseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  correctedBy  Expense[]           @relation("ExpenseCorrection")
  events       ExpenseEvent[]
  attachments  ExpenseAttachment[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, status, occurredOn])
  @@index([organizationId, branchId, occurredOn])
  @@index([organizationId, createdAt])
  @@map("expenses")
}

/// Append-only lifecycle history of an expense.
model ExpenseEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expenseId      String   @map("expense_id") @db.Uuid
  type           String
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  actorUserId    String   @map("actor_user_id") @db.Uuid
  reason         String?
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([expenseId, createdAt])
  @@map("expense_events")
}

/// Receipt or invoice files. Bytes live in private storage (AttachmentStorage), never here.
model ExpenseAttachment {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  expenseId        String   @map("expense_id") @db.Uuid
  storageKey       String   @unique @map("storage_key")
  fileName         String   @map("file_name")
  contentType      String   @map("content_type")
  sizeBytes        Int      @map("size_bytes")
  sha256           String   @db.Char(64)
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([expenseId])
  @@map("expense_attachments")
}

/// Operational, non-sale cash movements (append-only). Sales and refunds are never recorded here.
model CashMovement {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  /// Set: the movement is in that cashier session's drawer (counts towards its expected cash).
  sessionId        String?          @map("session_id") @db.Uuid
  /// C-000001, per organization.
  number           String
  type             CashMovementType
  direction        CashDirection
  amountMinor      BigInt           @map("amount_minor")
  currency         String           @db.Char(3)
  reason           String
  reference        String?
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  idempotencyKey   String           @map("idempotency_key")
  /// Set on a REVERSAL: the movement it reverses (at most one reversal each).
  reversesId       String?          @unique @map("reverses_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  branch     Branch          @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session    CashierSession? @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reverses   CashMovement?   @relation("CashReversal", fields: [reversesId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reversedBy CashMovement[]  @relation("CashReversal")

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, branchId, createdAt])
  @@index([sessionId])
  @@map("cash_movements")
}
