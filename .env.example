# Ventidoc environment variables. Copy to .env and replace every CHANGE_ME.
# Generate secrets with: openssl rand -base64 48
# Never commit real values. In production, inject these from a secret manager.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
VENTIDOC_MIGRATOR_PASSWORD=CHANGE_ME
VENTIDOC_AUTH_PASSWORD=CHANGE_ME
VENTIDOC_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- API runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:3001
# Runtime connection: MUST use the ventidoc_app role (cannot bypass RLS, owns no tables).
DATABASE_URL=postgresql://ventidoc_app:CHANGE_ME@127.0.0.1:5434/ventidoc
# Credential store connection: the ventidoc_auth role (password hashes only; no other table).
AUTH_DATABASE_URL=postgresql://ventidoc_auth:CHANGE_ME@127.0.0.1:5434/ventidoc
# Migration connection: the ventidoc_migrator role (schema owner). Never used by the running API.
MIGRATION_DATABASE_URL=postgresql://ventidoc_migrator:CHANGE_ME@127.0.0.1:5434/ventidoc
# Test databases (integration tests truncate these; never point them at real data).
TEST_DATABASE_URL=postgresql://ventidoc_app:CHANGE_ME@127.0.0.1:5434/ventidoc_test
TEST_AUTH_DATABASE_URL=postgresql://ventidoc_auth:CHANGE_ME@127.0.0.1:5434/ventidoc_test
TEST_MIGRATION_DATABASE_URL=postgresql://ventidoc_migrator:CHANGE_ME@127.0.0.1:5434/ventidoc_test
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380

# HMAC secret for short-lived access tokens. At least 32 random bytes.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# Public base URL of the web app, used to build email verification / reset links.
APP_PUBLIC_URL=http://localhost:3001
# Mail transport: "log" prints messages to the API log (development only; refused when NODE_ENV=production).
MAIL_TRANSPORT=log
MAIL_FROM="Ventidoc <no-reply@ventidoc.local>"
