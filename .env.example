# Ventidoc environment variables. Copy to .env and replace every CHANGE_ME.
# Generate secrets with: openssl rand -base64 48
# Never commit real values. In production, inject these from a secret manager.

# --- Local infrastructure (docker-compose.yml) ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
VENTIDOC_MIGRATOR_PASSWORD=CHANGE_ME
VENTIDOC_AUTH_PASSWORD=CHANGE_ME
VENTIDOC_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- API runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API with credentials.
WEB_ORIGINS=http://localhost:3001
# Runtime connection: MUST use the ventidoc_app role (cannot bypass RLS, owns no tables).
DATABASE_URL=postgresql://ventidoc_app:CHANGE_ME@127.0.0.1:5434/ventidoc
# Credential store connection: the ventidoc_auth role (password hashes only; no other table).
AUTH_DATABASE_URL=postgresql://ventidoc_auth:CHANGE_ME@127.0.0.1:5434/ventidoc
# Migration connection: the ventidoc_migrator role (schema owner). Never used by the running API.
MIGRATION_DATABASE_URL=postgresql://ventidoc_migrator:CHANGE_ME@127.0.0.1:5434/ventidoc
# Test databases (integration tests truncate these; never point them at real data).
TEST_DATABASE_URL=postgresql://ventidoc_app:CHANGE_ME@127.0.0.1:5434/ventidoc_test
TEST_AUTH_DATABASE_URL=postgresql://ventidoc_auth:CHANGE_ME@127.0.0.1:5434/ventidoc_test
TEST_MIGRATION_DATABASE_URL=postgresql://ventidoc_migrator:CHANGE_ME@127.0.0.1:5434/ventidoc_test
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380
# Integration tests use logical DB 1 so they never touch development keys.
TEST_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6380/1

# HMAC secret for short-lived access tokens. At least 32 random bytes.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# Public base URL of the web app, used to build email verification / reset links.
APP_PUBLIC_URL=http://localhost:3001

# --- Abuse protection / rate limiting (docs/security/rate-limiting-and-abuse-protection.md) ---
# Keys rate-limit buckets (HMAC) and signs device tokens. At least 32 random bytes.
ABUSE_PROTECTION_SECRET=CHANGE_ME
# Proxy IPs/CIDRs allowed to set X-Forwarded-For, comma-separated. EMPTY when clients connect
# directly. In production: exactly your load balancer / reverse proxy addresses, nothing broader.
TRUSTED_PROXIES=
# Optional per-policy tuning, e.g. login.ip=30/5m,forgot.email=3/1h (unknown names refuse to start).
RATE_LIMIT_OVERRIDES=
RATE_LIMIT_IPV6_PREFIX=64
RATE_LIMIT_KEY_PREFIX=vd
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_CONNECT_TIMEOUT_MS=2000

# --- MFA (docs/security/mfa.md) ---
# AES-256-GCM keys for TOTP secrets at rest: comma-separated "<id>:<base64 of exactly 32 random bytes>".
# Generate one with: openssl rand -base64 32. Keep retired keys listed until `pnpm api mfa:reencrypt`
# reports none in use. Production: supply from a secret manager/KMS, never from a plain file.
MFA_ENCRYPTION_KEYS=k1:CHANGE_ME
MFA_ENCRYPTION_ACTIVE_KEY_ID=k1

# --- Email (docs/security/email.md) ---
# AES-256-GCM keys for provider credentials and queued one-time values: "<id>:<base64 32 bytes>".
# Separate from MFA_ENCRYPTION_KEYS. Production: from a secret manager/KMS.
EMAIL_SECRET_KEYS=e1:CHANGE_ME
EMAIL_SECRET_ACTIVE_KEY_ID=e1
# inline: the API process also delivers email; external: run `pnpm api worker` separately; off: nothing delivers.
EMAIL_WORKER_MODE=inline
EMAIL_WORKER_POLL_MS=1000
# Bootstrap only (seed): suggested sender identity, created UNVERIFIED; production sending stays off.
EMAIL_SUGGESTED_SENDER=no-reply@mail.havehub.com.ng
# Development only: LOG prints emails to the API log. Ignored when NODE_ENV=production.
EMAIL_BOOTSTRAP_DEV_PROVIDER=LOG

# --- Customer support (docs/security/support.md) ---
# Attachments: only the local-disk driver exists (development/tests; production is refused until object storage is added).
SUPPORT_STORAGE_DRIVER=local
# Relative to the API's working directory; git-ignored. Never inside a served directory.
SUPPORT_STORAGE_DIR=.data/support-attachments
# Real-time events (Redis pub/sub; not durable, history is in PostgreSQL).
SUPPORT_EVENTS_CHANNEL=ventidoc:support:events
SUPPORT_STREAM_HEARTBEAT_MS=25000
# Open event streams re-check their session and permissions this often.
SUPPORT_STREAM_REVALIDATE_MS=30000
